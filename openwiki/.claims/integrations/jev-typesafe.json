  "claims": [
    {
      "id": "claim_742796486bee4e7db8ef3ce40f87cd58",
      "statement": "JevApiClient.isConfigured() returns whether the TypeSafe key has text, never calls Jev, never throws, and carries no resilience annotations, making it the single safe 'configured' check used outside the circuit breaker.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClient.java#L9-L14",
          "version": "repo-lines-v1:sha256:5f9027a1216dfebb494de3f943666be5f001cdf6c75ed050a8043dfec726a4b6:"
        },
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L34-L38",
          "version": "repo-lines-v1:sha256:d289e905a3e9948a5ae93a589f4d18e220885c44d1b13bd3ca8bc92055b9b776:"
        }
      ]
    },
    {
      "id": "claim_fba3bd39fd624b2bb34f34c694af2567",
      "statement": "JevApiClientImpl.judge validates requested questions are Noul or Score (rejecting Choice before the billed HTTP call), copies caller state into a new LinkedHashMap with null values removed without mutating the caller's map, and sends an empty state as {}.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L50-L65",
          "version": "repo-lines-v1:sha256:7801bd6ac9c2d9048333a7f7852ed4fc7a289fade9ea6fa6f0c7b0f8c9f89b91:"
        }
      ]
    },
    {
      "id": "claim_a4b6b8d6bdf045bca39fafcf5246b3ca",
      "statement": "JevApiClientImpl logs TypeSafeAuthenticationException/TypeSafePermissionDeniedException (401/403) with only HTTP status and request id before rethrowing, never the exception message or response body, since those can echo request content.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L63-L70",
          "version": "repo-lines-v1:sha256:51898d394b5cd360946c7149b1127d7892eda766c88a093001d135ee203bec2a:"
        }
      ]
    },
    {
      "id": "claim_b797a74021d54129b9b06bc533dc04e4",
      "statement": "JevApiClientImpl.judge carries no fallbackMethod, so typed SDK exceptions and CallNotPermittedException (open breaker) propagate unchanged to GlobalExceptionHandler instead of being wrapped into a generic failure.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L46-L49",
          "version": "repo-lines-v1:sha256:3aab0a7280d64e4215fe403805517ab5d11a3b24ab8e557d6e6ca21eb1149060:"
        }
      ]
    },
    {
      "id": "claim_af3524ebd1e14b3783ca6b4f14b63c85",
      "statement": "The interestScoringExecutor bean (InterestScoringConfig) has core pool size equal to max pool size equal to myfeeder.interest.concurrency (default 1), queue-capacity 1000, is registered with defaultCandidate=false so Boot's applicationTaskExecutor stays the default Executor, and is injected only via @Qualifier(InterestScoringConfig.EXECUTOR); no @Async is used anywhere in the scoring path.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/InterestScoringConfig.java#L25-L39",
          "version": "repo-lines-v1:sha256:0154995f7942c680c66c810698f5350bed048e2d2e0e25718a1a210e28176b3f:"
        },
        {
          "resource": "repo://src/main/resources/application.yaml#L34-L37",
