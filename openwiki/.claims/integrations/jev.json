  "claims": [
    {
      "id": "claim_fb2fad83e59449e5973fa247ab8cb864",
      "statement": "JevApiClientImpl.judge() applies @CircuitBreaker(name=\"jev\") and @Retry(name=\"jev\") with no fallbackMethod, so typed TypeSafe SDK exceptions and Resilience4j's CallNotPermittedException propagate out of judge() unchanged instead of being wrapped or swallowed.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L45-L49",
          "version": "repo-lines-v1:sha256:4e099fa71de1155497a1c6fd7eaf2e0788d0ea1df8129bf7e0e7053c4e48a284:"
        }
      ]
    },
    {
      "id": "claim_ce3a357118344fa1a7f0a7b8a0394c51",
      "statement": "JevApiClientImpl.isConfigured() carries no resilience annotations, so a configuration check never consumes a jev circuit breaker call slot or affects its metrics; requireConfigured() throws JevNotConfiguredException before the annotated judge() call is entered.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L33-L41",
          "version": "repo-lines-v1:sha256:f3fcbca0dd543e97ff0d72dea7a0223a3d604c0620f4fb5b9b78c0e8a1cfffbd:"
        }
      ]
    },
    {
      "id": "claim_6e073e100a5a41cc9180594b59f83f69",
      "statement": "judge() asserts every requested question is a Noul or Score (never Choice) before calling client.systemOne, so an unsupported question type fails before the billed HTTP call; the resulting IllegalArgumentException is listed in the jev circuit breaker's ignore-exceptions so it never counts as a breaker failure.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L54-L57",
          "version": "repo-lines-v1:sha256:9ca0d1e0a0a7836aab10fb7a9fb7845305637b029371bea0e6e071437bf8769f:"
        },
        {
          "resource": "repo://src/main/resources/application.yaml#L84-L91",
          "version": "repo-lines-v1:sha256:5cecffed15e6d9f08ced5a6f1b5caeedd237cc51b09e34ab62f2370637ebfc8b:"
        }
      ]
    },
    {
      "id": "claim_0a784fdcaf584b2d94ba842fe79cc500",
      "statement": "judge() catches TypeSafeAuthenticationException and TypeSafePermissionDeniedException, logs only the HTTP status and requestId (never the exception message or response body, which can echo request content), and rethrows the exception unchanged.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L65-L70",
          "version": "repo-lines-v1:sha256:782148c4232139378de0780b91c54f6c4e5b5ec3e98b11ffe7e2961753bf5aed:"
        }
      ]
    },
    {
      "id": "claim_14a842c438224311848e339998a15a3c",
      "statement": "judge() defensively copies the caller's state map into a new LinkedHashMap preserving order and strips null values before sending it to Jev, never mutating the caller's original map.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L59-L60",
          "version": "repo-lines-v1:sha256:750179bac0574e37ad4ad5dde50a70e08a81f4c5f8d4944ddfb3d2446272fa35:"
        }
      ]
    },
    {
      "id": "claim_433c59217dab4e29be0aa99930e1d45e",
      "statement": "TypeSafeConfig defines the TypeSafeClient bean itself so Spring's @ConditionalOnMissingBean causes the spring-ai-typesafe starter's own TypeSafeClient bean (which asserts a non-blank api-key and would crash startup) to back off; a missing/blank MYFEEDER_TYPESAFE_API_KEY only disables Jev calls, never the app.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/TypeSafeConfig.java#L21-L36",
          "version": "repo-lines-v1:sha256:904fbac4529801274469f15415d933d6c878c77f23e23e06497b99841ba9391a:"
        }
      ]
    },
    {
      "id": "claim_a7d60b4f357440b1a286ee3a0b83d12e",
      "statement": "TypeSafeConfig.typeSafeClient logs a fixed non-sensitive line when the api-key is blank and still builds a usable client; the key is supplied only via a Supplier overload (never the String overload, which asserts non-blank text) and the key value is never logged.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/TypeSafeConfig.java#L41-L51",
          "version": "repo-lines-v1:sha256:7408d3b557a422539c450681c1c2e2e98f5e9018f459725d7b5ab8030c382fec:"
        }
      ]
    },
    {
      "id": "claim_3446a3fc6d0f4676abdf36873f1bb285",
      "statement": "TypeSafeConfig sets baseUrl explicitly from spring.ai.typesafe configuration so the TypeSafe SDK never falls back to its own TYPESAFE_* environment variables.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/TypeSafeConfig.java#L48-L53",
          "version": "repo-lines-v1:sha256:ccfb32559c4e88dd741512302a886db678aa359542cdd188cb4b679705e53a18:"
        }
      ]
    },
    {
      "id": "claim_71d861454ac94ad1ababd76584bacff2",
      "statement": "TypeSafeConfig builds a Jev-only ReactorClientHttpRequestFactory with connect timeout 5s (JEV_CONNECT_TIMEOUT) and read timeout spring.ai.typesafe.timeout (30s), installed on a clone() of the auto-configured RestClient.Builder so the User-Agent customizer is preserved but the transport/timeouts are never reused for feed fetches or any other outbound call.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/TypeSafeConfig.java#L37-L53",
          "version": "repo-lines-v1:sha256:2494a7beadbc6913226d3f0ff7285d93ed6b97039579d47bc422a2225c974760:"
        }
      ]
    },
    {
      "id": "claim_89f536d351384115b61326d6e470d377",
      "statement": "The jevRetryInterval RetryConfigCustomizer reads the base wait-duration via Binder (not @Value Duration) and installs an IntervalBiFunction: a TypeSafeRateLimitException with a non-null retryAfterMs waits that value clamped to [0, 10000ms] (MAX_RETRY_AFTER_MS); otherwise it backs off exponentially from the base wait-duration (1s, then 2s).",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/TypeSafeConfig.java#L58-L80",
          "version": "repo-lines-v1:sha256:87e53e3b6760d0b42f133b5a1566a0a2ec5f0c1b9c60dfa36f8eee7e9351398a:"
        }
      ]
    },
    {
      "id": "claim_1ee4b80327c64174945d39a459086c88",
      "statement": "spring.ai.typesafe.retry.max-retries is set to 0 to disable the TypeSafe SDK's own built-in retry, making the Resilience4j 'jev' Retry instance the single retry layer for Jev calls.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/application.yaml#L9-L19",
          "version": "repo-lines-v1:sha256:33179c72292e35e03ca3c560040d8e4bfb3f5006870cbed17db0e74ef67a7674:"
        }
      ]
    },
    {
      "id": "claim_7907faa932dc4f02b24ffb8688c823e3",
      "statement": "The Resilience4j 'jev' retry instance uses max-attempts 3 and retries only TypeSafeRateLimitException (429), TypeSafeInternalServerException (5xx, including its TypeSafeOverloadedException subclass for 529), and TypeSafeApiConnectionException (including its TypeSafeApiTimeoutException subclass); it never retries 400, 422, 401, or 403 TypeSafe exceptions, and ignores JevNotConfiguredException.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/application.yaml#L102-L112",
          "version": "repo-lines-v1:sha256:fe7d38b7ab411f5f9b7d551259544441244585c7c749fe0c97d1ec3c453ca624:"
        }
      ]
    },
    {
      "id": "claim_9c958330da014f01a29bcd0655378773",
      "statement": "The 'jev' circuit breaker uses a COUNT_BASED sliding window of 20 calls with a minimum of 10 calls, a 50% failure-rate and 50% slow-call-rate threshold with a 15s slow-call duration threshold, opens for 60s, and automatically transitions from OPEN to HALF_OPEN after that wait without needing an inbound call, so a paused scoring sweep resumes probing Jev on its own.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/application.yaml#L74-L84",
          "version": "repo-lines-v1:sha256:7a73ecba7fe6c91abcda6fa567f926507d965402bf374ee1c51256919a1003f3:"
        }
      ]
    },
    {
      "id": "claim_a59c3bebcb104b8b8b481c4912d62fc1",
      "statement": "The 'jev' circuit breaker's ignore-exceptions list covers JevNotConfiguredException, TypeSafeBadRequestException, TypeSafeUnprocessableEntityException, TypeSafeMissingAnswerException, TypeSafeAnswerTypeException, and IllegalArgumentException, but deliberately omits TypeSafeAuthenticationException (401) and TypeSafePermissionDeniedException (403), so a bad or revoked API key is recorded as a breaker failure and can open the breaker like a real outage.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/application.yaml#L84-L91",
          "version": "repo-lines-v1:sha256:5cecffed15e6d9f08ced5a6f1b5caeedd237cc51b09e34ab62f2370637ebfc8b:"
        }
      ]
    },
    {
      "id": "claim_edf910580d5e4ad49e68aacf56bb199f",
      "statement": "JevEventLogging subscribes to the same named 'jev' CircuitBreaker and Retry instances used by the @CircuitBreaker/@Retry annotations (get-or-create by name) and logs fixed-text lines for retry attempts, retries-exhausted, and breaker state transitions, carrying only the exception's simple class name and numeric counters, never a message, response body, or API key.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/JevEventLogging.java#L26-L46",
          "version": "repo-lines-v1:sha256:b3312e4d0e4eb95f2eaff3bfec236267dbbd954a2861ad3a400dd80675984bc8:"
        }
      ]
    },
    {
      "id": "claim_d28c95169af5479eb65a45420e951af3",
      "statement": "The Jev event log lines are all greppable in production with the command kubectl -n myfeeder logs deploy/myfeeder | grep 'Jev ', which is the rollout evidence channel proving the breaker stayed CLOSED and that transient errors were absorbed by the retry layer.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/JevEventLogging.java#L10-L14",
          "version": "repo-lines-v1:sha256:f9df8a9229be034e58fc7a9cb53157680a19563506c81ecd9f037f0ee126a5f9:"
        },
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/JevEventLogging.java#L33-L42",
          "version": "repo-lines-v1:sha256:1424c85af9d48fa77030a8e456d831e0bbea01ce7e3e6a7918648a0f481e93e9:"
        }
      ]
    },
    {
      "id": "claim_b91bce2a15d2470595612b4a064e6bc5",
      "statement": "GlobalExceptionHandler maps JevNotConfiguredException to 503 with its own fixed message, CallNotPermittedException to 503 with fixed text 'Jev is temporarily unavailable', TypeSafeBadRequestException/TypeSafeUnprocessableEntityException to 422 with a status-only interpolated message, and any other TypeSafeException to a 503 catch-all with fixed text 'The Jev request failed. Try again later.' — never echoing the underlying TypeSafe exception message or response body.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/controller/GlobalExceptionHandler.java#L68-L105",
          "version": "repo-lines-v1:sha256:ed93848a9fe1933d218c063ae070ae776e658f0f3da20f2dd8a2fae3452d4d5d:"
        }
      ]
    }
