  "claims": [
    {
      "id": "claim_c1fd9a9cacbf4114aa57f81bff8de4a3",
      "statement": "TypeSafeConfig defines its own TypeSafeClient bean, causing the TypeSafe starter's @ConditionalOnMissingBean auto-configuration to back off, so a blank or missing spring.ai.typesafe.api-key only disables Jev scoring (logged as a fixed message) instead of crashing the app at startup the way the starter's own bean would.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/TypeSafeConfig.java#L23-L61",
          "version": "repo-lines-v1:sha256:fde25f643fd3b97ff438f82f3b7a177d8dd3ef273ab9714b2b879e52f27a242b:"
        }
      ]
    },
    {
      "id": "claim_cecdf1846bcf4ff3b7fb7375cb407068",
      "statement": "TypeSafeConfig passes the API key to TypeSafeClient.builder() via a Supplier<String> overload (never the String overload, which asserts non-blank text at build time) so the key is read lazily and is never logged, and sets baseUrl explicitly from TypeSafeProperties so the SDK never falls back to its own TYPESAFE_* environment variables.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/TypeSafeConfig.java#L43-L61",
          "version": "repo-lines-v1:sha256:1df96af2ef284f64c92c13fb281d6c728ad25754ab12e714b97c43ebaadd9360:"
        }
      ]
    },
    {
      "id": "claim_3a77509a5709493bb61ae4de3130c708",
      "statement": "The TypeSafeClient bean uses a Jev-only Reactor Netty request factory (connect timeout 5s, read timeout = spring.ai.typesafe.timeout) built on a clone() of the auto-configured RestClient.Builder, preserving the shared builder's User-Agent customizer while leaving the transport of other RestClient consumers (feed fetches, Raindrop) unaffected.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/TypeSafeConfig.java#L40-L61",
          "version": "repo-lines-v1:sha256:ce27e7d1e42989d50716858cd19358cdf9825558cab67e551ea172d5146d5dae:"
        }
      ]
    },
    {
      "id": "claim_fc45f98205d34337b944e7ae898d05ec",
      "statement": "JevApiClient.isConfigured() never throws, never calls Jev, and is not wrapped by the circuit breaker or retry, and is the single source of truth used both by the interest status endpoint and the scoring sweep gate.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClient.java#L9-L14",
          "version": "repo-lines-v1:sha256:5f9027a1216dfebb494de3f943666be5f001cdf6c75ed050a8043dfec726a4b6:"
        },
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L34-L44",
          "version": "repo-lines-v1:sha256:650d8fb893985ffc1cc1a723d00da4bdf6bc6e55950834f0742123db561b8f36:"
        }
      ]
    },
    {
      "id": "claim_7b0431e477bb4b88a41823caaed33701",
      "statement": "JevApiClientImpl.judge carries @CircuitBreaker(name=\"jev\") and @Retry(name=\"jev\") with no fallbackMethod, so typed TypeSafe SDK exceptions and CallNotPermittedException propagate unchanged to callers; this mirrors the RaindropService/RaindropApiClientImpl split where resilience annotations live only on a separate API-client bean because self-invocation would bypass the Resilience4j AOP proxy.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L46-L84",
          "version": "repo-lines-v1:sha256:556538d4edd8fc68a729d13b86c25517b54046dfae38e6d7c99e401b737cd15f:"
        }
      ]
    },
    {
      "id": "claim_c3be155ed6fb4ef1a4f26e2a36151eca",
      "statement": "JevApiClientImpl.judge validates that every requested question is a Noul or Score (never Choice), builds the state as an ordered JSON object with null values dropped without mutating the caller's map, and logs TypeSafeAuthenticationException/TypeSafePermissionDeniedException (401/403) at WARN with only status and request id, never the exception message or response body.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClientImpl.java#L46-L83",
          "version": "repo-lines-v1:sha256:247220589c89af23262d3b9ba65e2b5af09a868c88d1e9a15aa833eac67d5c83:"
        }
      ]
    },
    {
      "id": "claim_e204d91a2dd54f92ac5c94f76094fd43",
      "statement": "GlobalExceptionHandler maps JevNotConfiguredException to 503, CallNotPermittedException to 503 'Jev unavailable', TypeSafeBadRequestException/TypeSafeUnprocessableEntityException to 422, and any other TypeSafeException to 503, with every response detail a fixed string since TypeSafe exception messages/bodies can echo request content.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/controller/GlobalExceptionHandler.java#L71-L105",
          "version": "repo-lines-v1:sha256:edf5da9e2c8d1bfa5d6987cddad840f1c110953af343b4a736ff921ea722b28c:"
        }
      ]
    },
    {
      "id": "claim_8bea3e0dce384f01b1bfb6586480d6c1",
      "statement": "spring.ai.typesafe.retry.max-retries is 0, making the Resilience4j 'jev' retry instance the sole retry layer; re-enabling SDK retries is a standing invariant never to violate because it would stack a second retry layer and multiply outbound calls on every 429.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/application.yaml#L10-L20",
          "version": "repo-lines-v1:sha256:eb2059dadb512ac2c3536e8cbdc129059a48985bc31ec7b2af80f01a133b3a59:"
        },
        {
          "resource": "repo://src/main/resources/application.yaml#L102-L111",
          "version": "repo-lines-v1:sha256:2513169e4cddd4cc5eec86f4dc44f2011f34f4fd6796a83aa0ec377d1f8fb1b3:"
        }
      ]
    },
    {
      "id": "claim_4c6a5d4a6eec4a5ea2fa4e2564a33b5c",
      "statement": "The jev retry instance allows 3 attempts with a base wait-duration of 1s doubled per attempt (1s, 2s) via TypeSafeConfig.jevRetryInterval, except that a TypeSafeRateLimitException's retryAfterMs is honored instead when present, clamped to [0, 10000] ms (TypeSafeConfig.MAX_RETRY_AFTER_MS).",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/TypeSafeConfig.java#L63-L84",
          "version": "repo-lines-v1:sha256:ae59d027222719dee123ae25e63d2f409f65fbfdd42bb65ebb9767b42bef3c6c:"
        },
        {
          "resource": "repo://src/main/resources/application.yaml#L102-L111",
          "version": "repo-lines-v1:sha256:2513169e4cddd4cc5eec86f4dc44f2011f34f4fd6796a83aa0ec377d1f8fb1b3:"
        }
      ]
    },
    {
      "id": "claim_5088a64bcbbb4a289afca83287b7d243",
      "statement": "The jev retry instance retries only TypeSafeRateLimitException (429), TypeSafeInternalServerException (5xx/overloaded), and TypeSafeApiConnectionException (connection/timeout failures, including Jev-transport read timeouts which surface as this type rather than TypeSafeApiTimeoutException), and ignores JevNotConfiguredException; it never retries 400/422/401/403.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/JevApiClient.java#L16-L32",
          "version": "repo-lines-v1:sha256:39a08b68fb1da047cd65bb693a1eea08f9290d3e24ec4f18d66e3a1e94105e99:"
        },
        {
          "resource": "repo://src/main/resources/application.yaml#L102-L111",
          "version": "repo-lines-v1:sha256:2513169e4cddd4cc5eec86f4dc44f2011f34f4fd6796a83aa0ec377d1f8fb1b3:"
        }
      ]
    },
    {
      "id": "claim_8a8a9d1e0fb04d9781f3b8823cfdb2ab",
      "statement": "The jev circuit breaker is the outer Resilience4j aspect relative to retry (circuit-breaker-aspect-order 1 vs retry-aspect-order 2), uses a COUNT_BASED sliding window of size 20 with a minimum of 10 calls, a 50% failure-rate threshold, a 15s slow-call duration threshold at a 50% slow-call rate, stays OPEN for 60s, and automatically transitions OPEN to HALF_OPEN without requiring a call.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/application.yaml#L60-L85",
          "version": "repo-lines-v1:sha256:aa51ad0b5b48ce711bee5a78f7159c07d095950fb5452d03b1430c6764af2ba2:"
        }
      ]
    },
    {
      "id": "claim_1ca4aea7f7064c1fb9046b4398a1cb77",
      "statement": "The jev circuit breaker deliberately omits TypeSafeAuthenticationException and TypeSafePermissionDeniedException (401/403) from its ignore-exceptions list, so a bad or revoked API key is recorded as a failure and can open the breaker, in contrast to the Raindrop breaker which lists RaindropNotConfiguredException under ignore-exceptions for both its breaker and retry instances so an unconfigured token never counts as a failure.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/application.yaml#L60-L92",
          "version": "repo-lines-v1:sha256:6c2a6f58455d3ef63e9fe64efe9bf887b0659e5ef312b1f6e1b787612138806e:"
        }
      ]
    },
    {
      "id": "claim_8ef44321a86949b0b7f2413f5d2ce7d2",
      "statement": "The jev circuit breaker's ignore-exceptions list covers only caller-input/configuration problems that should never count as a Jev failure: JevNotConfiguredException, TypeSafeBadRequestException, TypeSafeUnprocessableEntityException, TypeSafeMissingAnswerException, TypeSafeAnswerTypeException, and IllegalArgumentException (the question-type assertion in JevApiClientImpl.judge).",
      "evidence": [
        {
          "resource": "repo://src/main/resources/application.yaml#L85-L92",
          "version": "repo-lines-v1:sha256:01b38d0a6a2d26cbdfffa44c5dee068b2394e178951ca67dd135b7fd9ccce4c4:"
        }
      ]
    },
    {
      "id": "claim_bf3ee6fc60c147849c116247e8946227",
      "statement": "JevEventLogging subscribes to the shared get-or-create 'jev' CircuitBreaker and Retry instances (the same instances the @CircuitBreaker/@Retry annotations on JevApiClientImpl.judge use) and logs retry attempts at INFO, retries-exhausted at WARN, and breaker state transitions at WARN, each line carrying only simple exception class names and numbers, never a message, response body, or API key; production lines are found via `kubectl -n myfeeder logs deploy/myfeeder | grep 'Jev '`.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/JevEventLogging.java#L10-L49",
          "version": "repo-lines-v1:sha256:48c9d46eceb93fe60d76bf8bbea3fadb618a7874705512beb972f59fc9f0dfd0:"
        }
      ]
    },
    {
      "id": "claim_6d44dc7c4f70453ea499289bd64b54b1",
      "statement": "InterestScoringConfig's interestScoringExecutor bean is registered with defaultCandidate=false (so it does not suppress Boot's applicationTaskExecutor via @ConditionalOnMissingBean(Executor.class)), sets core pool size equal to max pool size equal to myfeeder.interest.concurrency (default 1), uses a queue capacity of myfeeder.interest.queue-capacity (default 1000), and keeps Spring's default abort rejection policy.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/InterestScoringConfig.java#L25-L39",
          "version": "repo-lines-v1:sha256:0154995f7942c680c66c810698f5350bed048e2d2e0e25718a1a210e28176b3f:"
        },
        {
