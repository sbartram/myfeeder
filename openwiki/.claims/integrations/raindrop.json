    {
      "id": "claim_1bff90a1e39a4f6d945ff95789ec8436",
      "statement": "RaindropService.saveToRaindrop looks up the IntegrationConfig for IntegrationType.RAINDROP, throws IllegalStateException if missing or disabled or if the config JSON fails to deserialize, throws IllegalArgumentException if no collectionId is selected, and otherwise calls RaindropApiClient.createBookmark; listCollections() is cached via @Cacheable(\"raindrop-collections\").",
