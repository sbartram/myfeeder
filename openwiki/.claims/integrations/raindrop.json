          "resource": "repo://src/main/resources/application.yaml#L23-L42",
          "version": "repo-lines-v1:sha256:d0ee0e742ba5d762adf105b1a1aab235d9e1ba03b643044e87d25772d7bea006:"
        }
      ]
    },
    {
