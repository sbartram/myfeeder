  "claims": [
    {
      "id": "claim_9f709fce3ddf4254b3d0c6e21f526930",
      "statement": "RaindropService performs all business validation (IntegrationConfig lookup, enabled check, RaindropConfig deserialization, collectionId presence) before delegating to the RaindropApiClient interface, so validation failures (IllegalStateException for not-configured/disabled, IllegalArgumentException for no collection) never pass through the circuit breaker.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/RaindropService.java#L24-L45",
          "version": "repo-lines-v1:sha256:8896954cac205c03a65d4376650213cb9e2fcf8250d4bef112afc5aed70573d4:"
        }
      ]
    },
    {
      "id": "claim_95cd45adb5c546ea91226297e53bdc3e",
      "statement": "RaindropApiClientImpl is a separate Spring @Component from RaindropService specifically so that @CircuitBreaker and @Retry annotations on listCollections/createBookmark are invoked through the AOP proxy rather than via self-invocation, which would silently bypass Resilience4j.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/RaindropApiClientImpl.java#L32-L66",
          "version": "repo-lines-v1:sha256:f67d33951dd96f3b0ad14632734b73619184226cce9a16ecceddd375b9ab0b74:"
        }
      ]
    },
    {
      "id": "claim_b45fa77a14204a08849d08ae55737d5b",
      "statement": "RaindropApiClientImpl.requireConfigured() throws RaindropNotConfiguredException when the configured apiToken is null or blank, and this check runs inside the circuit-breaker/retry-wrapped methods before any HTTP call.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/RaindropApiClientImpl.java#L26-L36",
          "version": "repo-lines-v1:sha256:d5b408597eba39572b0ad1f5513a057ac4aab29a2e7721e5b131335e290af6d7:"
        }
      ]
    },
    {
      "id": "claim_d863262f3a364d7fb0fb07422e0b3fcf",
      "statement": "The fallback methods listCollectionsFallback/createBookmarkFallback rethrow RaindropNotConfiguredException as-is but wrap every other throwable into IllegalStateException(\"Raindrop.io is currently unavailable\", throwable).",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/RaindropApiClientImpl.java#L68-L84",
          "version": "repo-lines-v1:sha256:bc8a16de91f5fae8e68ed204f9fec99585fe0522116fb80cb311b80c998cd603:"
        }
      ]
    },
    {
      "id": "claim_97e12364e6064b15871588724f69c78e",
      "statement": "GlobalExceptionHandler maps RaindropNotConfiguredException to HTTP 503, IllegalStateException to HTTP 409, and IllegalArgumentException to HTTP 400, which is why the fallback rethrow of RaindropNotConfiguredException must bypass the generic wrapping.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/controller/GlobalExceptionHandler.java#L44-L63",
          "version": "repo-lines-v1:sha256:c04ce22d67f81151251a4f2eed0e9fb9f762c1f85005ec0b4a96bfcaa44690cf:"
        }
      ]
    },
    {
      "id": "claim_d9ac8a375c1f4798b803658b89b872d4",
      "statement": "application.yaml lists RaindropNotConfiguredException under ignore-exceptions for both the resilience4j circuitbreaker and retry 'raindrop' instances, preventing an unconfigured token from counting as a circuit-breaker failure or consuming retry attempts.",
      "evidence": [
