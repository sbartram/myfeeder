  "claims": [
    {
      "id": "claim_843da0c1948f49b8b0648b33889b96ce",
      "statement": "RaindropService performs business-rule validation (integration existence, enabled flag, RaindropConfig deserialization, collectionId presence) before ever invoking RaindropApiClient, so IllegalStateException/IllegalArgumentException from bad configuration never pass through the Resilience4j circuit breaker.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/RaindropService.java#L24-L45",
          "version": "repo-lines-v1:sha256:8896954cac205c03a65d4376650213cb9e2fcf8250d4bef112afc5aed70573d4:"
        }
      ]
    },
    {
      "id": "claim_956ba148ab9642feb919800a02a2bf5b",
      "statement": "RaindropApiClientImpl is a separate Spring @Component bean (not a method on RaindropService) specifically so its @CircuitBreaker/@Retry annotations, which are AOP-proxy-based, are not bypassed by self-invocation.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/RaindropApiClientImpl.java#L12-L34",
          "version": "repo-lines-v1:sha256:d7a3d8ab35de9f738bbf70747150774d3c251ed3351fc1ea9c839338ec0925a7:"
        }
      ]
    },
    {
      "id": "claim_f52b4a87661549c794191785c93e67d0",
      "statement": "RaindropService.listCollections() is cached under the 'raindrop-collections' Cacheable name so the Settings UI's collection picker does not call the Raindrop API on every render.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/RaindropService.java#L47-L52",
          "version": "repo-lines-v1:sha256:f283384b71d5347f2120c73186d6d1bfae8e16363501927a4aea573653d15e1f:"
        }
      ]
    },
    {
      "id": "claim_116b08f1a9a2468d92baf96caab97eb6",
      "statement": "RaindropApiClientImpl's fallback methods (listCollectionsFallback, createBookmarkFallback) special-case RaindropNotConfiguredException and rethrow it unchanged; all other throwables are wrapped as IllegalStateException(\"Raindrop.io is currently unavailable\", throwable).",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/integration/RaindropApiClientImpl.java#L68-L84",
          "version": "repo-lines-v1:sha256:bc8a16de91f5fae8e68ed204f9fec99585fe0522116fb80cb311b80c998cd603:"
        }
      ]
    },
    {
      "id": "claim_9a9bc78f4bed4c318642d27432779773",
      "statement": "RaindropNotConfiguredException is listed under ignore-exceptions for both the raindrop circuitbreaker and retry instances in application.yaml, so an unconfigured token is not treated as a circuit-breaker failure or retried.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/application.yaml#L23-L42",
          "version": "repo-lines-v1:sha256:d0ee0e742ba5d762adf105b1a1aab235d9e1ba03b643044e87d25772d7bea006:"
