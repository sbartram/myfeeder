    },
    {
      "id": "claim_e79c16d57afb4c15a8aa7cfa046198b7",
      "statement": "Jev retries occur only at the Resilience4j jev retry instance; spring.ai.typesafe.retry.max-retries is set to 0 to disable the TypeSafe SDK's own retry layer, so the two layers never stack and multiply requests after a 429.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L237-L237",
          "version": "repo-lines-v1:sha256:7ab6791c793f66142690ef5669406a31d92872a6af635a9e6784214291cb59ad:"
