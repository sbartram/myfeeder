    {
      "id": "claim_ad666bb1106b45e99a23e1ad9ed68eb5",
      "statement": "The scoring executor keeps the default abort rejection policy on purpose: ScoringQueue.submit catches the resulting TaskRejectedException, releases the article id from its in-flight set, and counts it as dropped so the sweep can retry it later; a discarding policy would instead leave the id marked in-flight forever.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/InterestScoringConfig.java#L15-L19",
          "version": "repo-lines-v1:sha256:015f438dcb834c2db214c2b29cd7fd925d0c93b983d3de891b36caa6c8e0b090:"
