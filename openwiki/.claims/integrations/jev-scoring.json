          "version": "repo-lines-v1:sha256:de729a69c86852371b9328141c76e0e8d4b991f07623f199fbc7e57c7bc2e821:"
        }
      ]
    },
    {
      "id": "claim_15c6747212354a49b405ffc62356a369",
      "statement": "InterestScoringSweep runs on a fixedDelay of myfeeder.interest.sweep-delay (default PT2M) after sweep-initial-delay (PT1M), and each run enqueues at most min(ScoringQueue.remainingCapacity(), sweep-batch-size) eligible articles newest-first, skipping the run when Jev is unconfigured, the jev breaker is OPEN/FORCED_OPEN, or the app is in cold start.",
      "evidence": [
