    {
      "id": "claim_b77e385252ec4c0d88f4ad418decdbe6",
      "statement": "judge() rejects any Question that is not Noul or Score with an IllegalArgumentException before the HTTP call, preventing a Choice question from being billed and then silently dropped; this exception is listed in the jev breaker's ignore-exceptions so it never opens the breaker.",
