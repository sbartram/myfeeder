    {
      "id": "claim_9ee416a57e1b44f2861811d6d1364aa5",
      "statement": "JevApiClient.isConfigured() checks whether the TypeSafe key has text, never calls Jev, and is not wrapped by the jev circuit breaker or retry; it is the single 'configured' rule used by the interest status endpoint and the scoring gate.",
