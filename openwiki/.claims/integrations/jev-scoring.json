    {
      "id": "claim_b1f2e83b6aad4f93ad86e6131e611c2a",
      "statement": "JevApiClientImpl.judge carries @CircuitBreaker(name=\"jev\") and @Retry(name=\"jev\") with no fallbackMethod, so typed TypeSafe SDK exceptions and CallNotPermittedException propagate unchanged to GlobalExceptionHandler; 401/403 responses are logged with only status and requestId before rethrowing.",
      "evidence": [
