    {
      "id": "claim_ca08b2c3fe5148fd9c25ae3531c0bc15",
      "statement": "config/JevEventLogging subscribes to the jev retry and breaker event publishers (same registry instances the @CircuitBreaker/@Retry annotations use) and logs three fixed-format lines carrying only exception simple class names and numbers, never a message, response body, or API key: a retry-attempt INFO line, a retries-exhausted WARN line, and a breaker state-transition WARN line using StateTransition.name().",
      "evidence": [
