    {
      "id": "claim_5ebf1248d448498e8f1acb84856c4ea4",
      "statement": "The interestScoringExecutor bean (InterestScoringConfig.EXECUTOR) is a non-default-candidate ThreadPoolTaskExecutor with core and max pool size both bound to myfeeder.interest.concurrency (fixed at 1 by design, D-07), queue-capacity 1000, thread prefix jev-score-, and no @Async usage anywhere; defaultCandidate=false prevents it from satisfying Boot's @ConditionalOnMissingBean(Executor.class) and silently removing applicationTaskExecutor.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/InterestScoringConfig.java#L1-L39",
          "version": "repo-lines-v1:sha256:772b6f4ca6cadf02e0085417c909718766c347c5f2ec6ded7bb78c25dff06101:"
