    {
      "id": "claim_938d32389c3a49368b98a18a9a4a1dd8",
      "statement": "FeedPollingScheduler.registerFeed first cancels any existing scheduled task for the feed id before computing the effective interval and scheduling pollAndAdjust via TaskScheduler.scheduleAtFixedRate, so re-publishing FeedSavedEvent for the same feed safely replaces its schedule instead of stacking a second task.",
