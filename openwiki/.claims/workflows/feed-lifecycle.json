        }
      ]
    },
    {
      "id": "claim_365de2a880644a2fb0c5247daadd81bf",
      "statement": "FeedUrlValidator's SSRF guard has two deliberately accepted gaps for the single-user LAN deployment: it does not protect against DNS rebinding/TOCTOU between its own resolution and RestClient's connect-time resolution, and it does not re-validate redirects per hop.",
