    {
      "id": "claim_1e8cb55f8877456db0bbf48c2f0215e6",
      "statement": "GET /api/articles/{id}/extracted-content (ArticleExtractionService.extract) serves a cached article.extracted_content when present, otherwise fetches the article's original page through the same FeedFetcher used for feed polling (inheriting its SSRF guard and 10 MiB cap), decodes it with jsoup's charset detection, extracts readable content via Readability4J, and caches the result into article.extracted_content; it throws NotFoundException (404), IllegalArgumentException (400, no URL), FeedFetchException (422, fetch failure), or FeedParseException (422, no extractable content).",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/controller/ArticleController.java#L86-L89",
          "version": "repo-lines-v1:sha256:7de5ee387f58f5adc3ecb19820a18c5beef19568cf99b64c51e67501b8d69938:"
