    {
      "id": "claim_590a57b70a4a47369af5bb021642519d",
      "statement": "FeedPollingService.pollFeed does a conditional fetch (If-None-Match/If-Modified-Since); a 304 only updates lastPolledAt, while a 200 re-parses and inserts only articles that don't already exist for (feed_id, guid), preventing duplicate articles across polls.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/FeedPollingService.java#L26-L68",
          "version": "repo-lines-v1:sha256:c62c8d06279f122c418fbf06e486ca7b55178a010b090d4f925857070b45a83a:"
