          "resource": "repo://src/main/java/org/bartram/myfeeder/service/FeedUrlValidator.java#L11-L26",
          "version": "repo-lines-v1:sha256:34adb679a280ba0f429db718aaa8a3c186b4ae09b221cb69b751d57177989b43:"
        }
