    {
      "id": "claim_1233b4cb43954495afb5696d62d4f3d9",
      "statement": "FeedUrlValidator.validate rejects feed URLs that are not http/https, have no host, or resolve to a non-public address (loopback, link-local, RFC1918 site-local, any-local, multicast, carrier-grade NAT 100.64.0.0/10, IPv6 unique-local fc00::/7, or the IPv4 limited broadcast address), throwing IllegalArgumentException which GlobalExceptionHandler maps to HTTP 400.",
      "evidence": [
