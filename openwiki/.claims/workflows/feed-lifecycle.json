        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/FeedUrlValidator.java#L18-L26",
          "version": "repo-lines-v1:sha256:920eb8f3039628d60a90558f14cc549d14555b5ee2b22effbbaa58b65f8a097d:"
