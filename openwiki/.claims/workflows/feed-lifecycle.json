    {
      "id": "claim_9e4ae5a2987842f181d3440a8154cf30",
      "statement": "FeedFetcher is the single component that performs outbound HTTP retrieval of a caller-supplied URL, and it applies an SSRF guard (FeedUrlValidator.validate) before every request plus a body size cap (DEFAULT_MAX_FEED_BYTES = 10 MiB, enforced via a bounded readNBytes) on every fetch, regardless of caller.",
      "evidence": [
