    {
      "id": "claim_258ea9a350e8426ba8ee33f3fa3972c5",
      "statement": "FeedPollingScheduler listens for FeedSavedEvent/FeedDeletedEvent via @TransactionalEventListener(phase = AFTER_COMMIT, fallbackExecution = true), registering/cancelling scheduled polling only after the feed row is durably committed while still firing in non-transactional test contexts; onStartup (ApplicationReadyEvent) registers every existing feed at boot.",
      "evidence": [
        {
