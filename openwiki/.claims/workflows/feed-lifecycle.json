    {
      "id": "claim_b2a2ecd1f1344e61acea3bae592dab1f",
      "statement": "FeedFetcher is the single HTTP fetch path for both feed subscribe/poll and reader-view extraction; before dereferencing a URL it calls FeedUrlValidator.validate, which requires an http/https scheme and rejects hosts resolving to loopback, link-local, RFC1918 site-local, any-local, multicast, fc00::/7 unique-local, 100.64.0.0/10 CGNAT, 255.255.255.255, or IPv4-mapped-to-blocked-IPv4 addresses, throwing IllegalArgumentException mapped to HTTP 400.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/controller/GlobalExceptionHandler.java#L50-L55",
          "version": "repo-lines-v1:sha256:d33e9d155eda6eae41ede4fedb52c50b757fc100ed9a4a593ee1972a6812be78:"
        },
