    {
      "id": "claim_789efa2aa8004fc987bd67c6d19fd97c",
      "statement": "ArticleEngagementStore is the sole reader/writer of article_engagement: record() is an idempotent INSERT ... ON CONFLICT (article_id, kind) DO NOTHING, recordQuietly() wraps it and swallows DataAccessException with a WARN log containing only the kind, article id, and exception class name (never the message/cause), and no method in the class opens its own transaction, so a failed engagement insert cannot abort the save that triggered it.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/repository/ArticleEngagementStore.java#L26-L45",
          "version": "repo-lines-v1:sha256:44ccd8c3274d7e2ec8319a11677d12d01572962a052ebf1ee9af87ce522b9794:"
        }
      ]
    },
