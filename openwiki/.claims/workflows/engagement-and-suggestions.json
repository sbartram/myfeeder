    {
      "id": "claim_ab58310744674881b8474f11ac503cfa",
      "statement": "InterestScoreQueries.LEARNED_CTE blends thumbs votes and engagement in stages: learned sums vote*hinge over article_feedback; engaged collapses article_engagement to one MAX(strength) row per article before any topic join (OPEN_ORIGINAL -> engagementOpenWeight, every other kind -> engagementSaveWeight) and excludes any article with an article_feedback row; eng_learned sums strength*hinge per topic over SCORED articles with no age/read window; eff clamps thumbs to +/-learnedCap and engagement to [0, engagementCap] with both forced to 0 for a negative-base topic; eff2 applies one sign clamp plus +/-50 range to produce w_thumbs (base+learned) and w (base+learned+eng).",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/repository/InterestScoreQueries.java#L99-L150",
          "version": "repo-lines-v1:sha256:05092ee1705ec2bcc4fe8dc93146dc6443edac7609b63f46bfae86f146eaf92a:"
        }
      ]
    },
    {
      "id": "claim_631ba454f76e4b7499a614394b190be5",
      "statement": "LearnedLimit.of judges a topic's TopicWeight in fixed precedence: LEARNED_CAP when |learnedRaw| >= learnedCap, then SIGN_CLAMP when base+learned crosses zero, then WEIGHT_RANGE when |base+learned| exceeds InterestService.MAX_WEIGHT (50), then ENGAGEMENT_CAP when no prior bound holds and engagementRaw >= engagementCap (cap 0 or a negative base always exempt this), otherwise NONE.",
      "evidence": [
