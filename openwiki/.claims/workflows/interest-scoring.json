    {
      "id": "claim_7534e8497bb744749ef98751862b0894",
      "statement": "After a successful judge() call, ArticleScoringService re-reads the current profile version and each topic's version and compares them against a pre-call snapshot (sameRubric); if either changed, the judgment is discarded entirely (nothing written, no attempt recorded), leaving the article for the sweep to re-score against the current rubric, which prevents a write-once SCORED row from permanently pinning a judgment against a rubric the reader has already replaced.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/ArticleScoringService.java#L140-L156",
          "version": "repo-lines-v1:sha256:628a031a8d939d6c4caf95850940703587cf25dc4785c0142ee04f7994d12b60:"
