    {
      "id": "claim_5a6615ad36924ba096b08f52633d5691",
      "statement": "InterestScoringSweep skips its run entirely (no ids enqueued) when the Jev client is unconfigured, when the jev circuit breaker state is OPEN or FORCED_OPEN (HALF_OPEN is allowed to run), or when InterestService.isColdStart() is true; any RuntimeException in the sweep body is caught and logged rather than propagated.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/scheduler/InterestScoringSweep.java#L43-L69",
