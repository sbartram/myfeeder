    },
    {
      "id": "claim_05f9e91852aa4f809bdcec9330fde0e3",
      "statement": "A transient scoring failure (429, 5xx, connection/timeout failure, an open circuit breaker, a missing Jev key, or 401/403, per ScoringFailure.isTransient) writes no article_score row and consumes no attempt, so it is exempt from the 3-attempt bound that governs other (permanent) failures.",
      "evidence": [
