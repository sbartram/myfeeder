    {
      "id": "claim_643dd87d929144a5bf5f97f60d3be2cf",
      "statement": "An article is eligible for scoring when it is unread and COALESCE(published_at, fetched_at) is within myfeeder.interest.window-days (default 14) of now, and it needs scoring when it has no article_score row or a FAILED row with attempts under ArticleScoreStore.MAX_ATTEMPTS (3); this ELIGIBLE/NEEDS_SCORING predicate is shared by the sweep, the per-article dispatch recheck, the status counts, and Re-score.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/repository/ArticleScoreStore.java#L33-L55",
          "version": "repo-lines-v1:sha256:c250bf9649067b956ce2c2849ad68f3d193820b13fccfb757a5acdc930f4b0e5:"
        }
