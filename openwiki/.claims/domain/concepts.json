    {
      "id": "claim_2b0f7c4927ed4def9070ce1ac38ef7c1",
      "statement": "InterestScoreQueries.LEARNED_CTE computes w_thumbs as the base weight plus a learnRate-scaled, +/-learnedCap-clamped sum of vote*hinge over article_feedback votes on SCORED articles, then applies a sign clamp (a positive-base topic's effective weight floors at 0, a negative-base topic's ceilings at 0, a zero-base topic can move either way) within -50..50; this w_thumbs is the thumbs-only effective weight used nowhere in storage, only computed at query time.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/repository/InterestScoreQueries.java#L111-L138",
          "version": "repo-lines-v1:sha256:94c625f1322828d7356e09fc9350721431e913a89faf2db07b6f9327a69a5753:"
        }
      ]
    },
    {
      "id": "claim_7f866a30cb7c4638a0635834d9863607",
      "statement": "Engagement is folded into the blend as a second, independently capped additive term computed only at query time: the engaged CTE takes the MAX configured strength per article across its engagement kinds and drops any article that has a stored thumbs vote (vote always overrides engagement for that article); eng_learned sums strength*hinge per topic over SCORED articles with no age or read-state window; eff caps the learnRate-scaled sum at engagementCap with a zero floor and forces a negative-base topic's engagement contribution to zero in SQL; eff2's column w applies the same sign-clamp as w_thumbs but to base+learned+eng, and that w is the effective weight used in the Priority score and badge.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/repository/InterestScoreQueries.java#L111-L138",
          "version": "repo-lines-v1:sha256:94c625f1322828d7356e09fc9350721431e913a89faf2db07b6f9327a69a5753:"
        }
      ]
