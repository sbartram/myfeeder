    {
      "id": "claim_b817b9c2bd4040169f8368420d9697d4",
      "statement": "article_score.status follows a three-state lifecycle: SCORED is write-once (it can overwrite a FAILED row but never a SCORED or SKIPPED row), FAILED is retried up to ArticleScoreStore.MAX_ATTEMPTS (3) before becoming exhausted, and SKIPPED is a terminal first-writer-wins state for articles that can never be judged (e.g. no GUID or no judgeable text).",
      "evidence": [
        {
