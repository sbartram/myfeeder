    {
      "id": "claim_3feb8c74cb59452685a9e3e5a4c88363",
      "statement": "ArticleExtractionService implements the reader-view extraction: given an article ID it returns cached extracted_content if present, otherwise fetches the article's original page through FeedFetcher (inheriting the SSRF guard, size cap, and User-Agent), decodes the bytes with jsoup using the response's declared charset or jsoup's own BOM/meta-tag detection, parses the decoded HTML with Readability4J, and on success caches the resulting content HTML via saveExtractedContent before returning an ExtractedContent(title, contentHtml) record.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/ArticleExtractionService.java",
          "version": "repo-file-v1:sha256:669160a7f4079b0b4dd06d2b4b5a903b242f1e6cdce9690565452db01cd334b0"
        },
