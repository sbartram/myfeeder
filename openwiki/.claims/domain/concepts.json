    {
      "id": "claim_3970c05502a2491d8a803551117ce38f",
      "statement": "PriorityPage encodes its cursor as base64url(score|epochMicros|id) built from the literal sort tuple served to the client, and PriorityService/InterestScoreQueries.priorityPageAfter compares the next page against that served tuple rather than re-reading the cursor article's live score, so a later score change on the cursor row cannot cause rows to be skipped; this differs from the Long-cursor PaginatedResponse scheme used by every other list endpoint, which is keyed on the cursor row's live numeric id/date because those sort columns are stable.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/controller/PriorityPage.java#L14-L46",
          "version": "repo-lines-v1:sha256:9acf8f9ae96560e5a95af7f99bf7705446b816930419f4c2d7c6b39d2c6bcc11:"
