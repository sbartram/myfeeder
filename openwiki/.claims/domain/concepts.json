    {
      "id": "claim_5ea87f0329c2408ba9a256bdc12bd67f",
      "statement": "PriorityPage.decodeCursor throws a 404 NotFoundException with a fixed, non-echoing message whenever the cursor cannot be parsed, has the wrong shape, parses to a NaN score, or decodes to a date outside 0001-01-01T00:00:00Z..9999-12-31T23:59:59.999999Z (chosen because that range is representable in Postgres timestamptz without silently clamping to -infinity/infinity); 404 rather than 400 is used deliberately so an old client sending a stale numeric cursor and a client sending a malformed opaque cursor both trigger the same 'restart from page 1' handling in PriorityList.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/controller/PriorityPage.java#L50-L86",
