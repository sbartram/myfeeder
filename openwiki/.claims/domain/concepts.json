    {
      "id": "claim_ebee922ef53e4a2982aa7b66a9e2263a",
      "statement": "V6__interest_scoring.sql creates the complete v0.2.1 interest-ranking schema in one migration: a singleton interest_profile row, interest_topic rubric lines, article_score/article_topic_score (Jev's judgment per article), and article_feedback/article_feedback_topic (the user's thumbs vote); no later migration changes this schema.",
      "evidence": [
        {
          "resource": "repo://src/main/resources/db/migration/V6__interest_scoring.sql",
          "version": "repo-file-v1:sha256:d30123e21133a3c127d7e4c5b4222e85de21cea87090447fb0f2ceb0ac699adc"
        }
      ]
    },
