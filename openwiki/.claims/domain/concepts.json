          "resource": "repo://src/main/resources/db/migration/V5__article_extracted_content.sql",
          "version": "repo-file-v1:sha256:40144184eb66db1770bd31199ab5e043f157d4218386b7cc428363058171a6a5"
        }
      ]
    },
    {
      "id": "claim_986d024e5dce4ad7a65bcfee7c695170",
      "statement": "article.extracted_content is aged out by the same RetentionService.cleanupOldContent scheduled job that clears article.content, via a single clearContentOlderThan UPDATE that sets both columns to NULL when fetched_at is older than the configured retention cutoff; there is no separate lifecycle or cron for extracted_content.",
      "evidence": [
        {
