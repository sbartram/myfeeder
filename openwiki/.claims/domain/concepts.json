    },
    {
      "id": "claim_2e674b654867408c8ca4e975a2f68895",
      "statement": "article.summary is not cleared by RetentionService's cleanup: clearContentOlderThan's UPDATE statement only nulls content and extracted_content, so summary persists indefinitely on older articles.",
