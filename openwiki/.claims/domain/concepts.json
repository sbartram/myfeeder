    {
      "id": "claim_2110796fa8e0482ca0a88afe9b96a1a6",
      "statement": "The Article JDBC entity (model/Article.java) does not map extracted_content as a Java field; it is accessed exclusively via ArticleRepository.findExtractedContent(Long id), which returns null when nothing is cached or the article is missing, and ArticleRepository.saveExtractedContent(Long id, String content), so ordinary save()/findById() calls never read or write that column.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/model/Article.java",
          "version": "repo-file-v1:sha256:9aaa84fcffa2192f5ef7921e766ec12655ec430aa836c65e817bf5b5f56629e7"
