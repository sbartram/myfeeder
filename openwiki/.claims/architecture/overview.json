    {
      "id": "claim_73a4dd383056411a9af48ab18f9275dd",
      "statement": "GlobalExceptionHandler (@RestControllerAdvice) maps NotFoundException→404, IllegalArgumentException→400, OpmlParseException→400, IllegalStateException→409, FeedParseException→422, FeedFetchException→422, RaindropNotConfiguredException→503, JevNotConfiguredException→503, CallNotPermittedException→503, TypeSafeBadRequestException/TypeSafeUnprocessableEntityException→422, and any other TypeSafeException→503, each to a ProblemDetail response.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/controller/GlobalExceptionHandler.java",
          "version": "repo-file-v1:sha256:7c32c42bd6cd11de7d12ca516a96f79bb0dd80fcbee5a18199fd09d608d91227"
        }
      ]
    },
    {
      "id": "claim_6b3e89e54279428bb11e8d4db061421a",
      "statement": "The Jev exception handlers in GlobalExceptionHandler always return fixed, app-owned detail text and never forward a TypeSafe exception's own message or response body, because TypeSafe error content can echo request details.",
      "evidence": [
        {
