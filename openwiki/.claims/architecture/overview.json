    {
      "id": "claim_5e3e2b3a42754b2a97c93e57a88e062e",
      "statement": "The org.bartram.myfeeder backend is a layered architecture (controller → service → repository) built on Spring Boot 4, with MyfeederApplication as the entry point annotated @EnableScheduling and @ConfigurationPropertiesScan.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/MyfeederApplication.java",
          "version": "repo-file-v1:sha256:69fe3b236c5d4d83153b5aaf553a0913a7854163805f1232c90fe207f1a63c5d"
        }
      ]
    },
    {
      "id": "claim_d731eefd44044f5887bd86e746647940",
      "statement": "Persistence uses Spring Data JDBC (not JPA): entities use @Table/@Id from org.springframework.data annotations, there is no lazy loading, and custom queries require @Query since derived query methods are unsupported.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L156-L162",
          "version": "repo-lines-v1:sha256:0942321f82ca90bff33f7f48b84a811e726e65dafe62c7f45fd8a19df99b6b37:"
        }
