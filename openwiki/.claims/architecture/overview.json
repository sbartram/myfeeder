    {
      "id": "claim_a788b5e7cb9543c385e85e7de730eae4",
      "statement": "FeedParser resolves feed type by sniffing raw bytes decoded as ISO-8859-1 (a byte-transparent charset) to locate ASCII markers ({, <feed, Atom namespace URI) regardless of the document's real encoding, classifying it as JSON Feed, Atom, or RSS.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/parser/FeedParser.java#L61-L72",
          "version": "repo-lines-v1:sha256:1d23b6787b98cbcf667f5fed57f5682ff46a07b3b7793b575e8e1c462ffc23f3:"
        }
      ]
    },
    {
      "id": "claim_f033051e44ba4a5d86eff28d40a46513",
      "statement": "For RSS/Atom documents, FeedParser resolves the decoding charset with precedence: an explicit charset in the Content-Type header wins (constructing ROME's XmlReader in HTTP mode); otherwise XmlReader's raw-mode detection is used (BOM, then XML prolog encoding=, then UTF-8) specifically to avoid HTTP-mode's RFC 3023 us-ascii default for text/xml, which would corrupt multi-byte content.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/parser/FeedParser.java#L95-L106",
          "version": "repo-lines-v1:sha256:6993ce5c99025887e7fb559ed5fd48ff8aede103da5bac201f2c261affeeac41:"
        }
      ]
    },
    {
      "id": "claim_c0a45baf0f844c73a122aa05b2d2ace9",
      "statement": "JSON Feed documents are parsed as UTF-8 by spec; FeedParser relies on Jackson's ObjectMapper.readTree to auto-detect the UTF byte-order family, performing no explicit charset resolution for JSON Feed.",
      "evidence": [
