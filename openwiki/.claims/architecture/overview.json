    },
    {
      "id": "claim_656a4cebad3f49d0bdab4d033c479b2c",
      "statement": "FeedUrlValidator enforces an SSRF guard at the top of FeedFetcher.fetch(...): it requires http/https scheme, resolves the host, and rejects loopback, link-local, RFC1918 site-local, carrier-grade NAT (100.64.0.0/10), IPv6 unique-local (fc00::/7), any-local, and multicast addresses, throwing IllegalArgumentException (mapped to HTTP 400) on rejection.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/controller/GlobalExceptionHandler.java#L44-L49",
          "version": "repo-lines-v1:sha256:d33e9d155eda6eae41ede4fedb52c50b757fc100ed9a4a593ee1972a6812be78:"
