    {
      "id": "claim_f039a51105ea422397ab66e9080a9d31",
      "statement": "FeedUrlValidator has an accepted DNS-rebinding/TOCTOU limitation (the host is re-resolved by RestClient at connect time, after validation) and does not re-validate redirect targets per hop; both are accepted for the current single-user LAN deployment.",
