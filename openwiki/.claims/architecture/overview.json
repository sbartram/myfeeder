    {
      "id": "claim_7e2c39056f8b46e18a295b1e27aa9496",
      "statement": "InterestScoringConfig registers a single-threaded (core=max=myfeeder.interest.concurrency), bounded-queue (myfeeder.interest.queue-capacity) ThreadPoolTaskExecutor named 'interestScoringExecutor', with defaultCandidate=false so it never satisfies Boot's @ConditionalOnMissingBean(Executor.class) and replace the default applicationTaskExecutor; consumers inject it via @Qualifier(InterestScoringConfig.EXECUTOR).",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/config/InterestScoringConfig.java",
          "version": "repo-file-v1:sha256:b1f6d879b7f1819a44b5ba28707b7b06ebddba5d574118f8ee168a8f1ccd9e87"
        }
      ]
    },
    {
      "id": "claim_47c313ba15a7482f8c1d0550b022d76f",
      "statement": "ScoringQueue tracks in-flight article ids in a ConcurrentHashMap set, submits each id at most once to the interestScoringExecutor, and relies on the executor's default abort rejection policy: when the queue is full, execute() throws TaskRejectedException, which ScoringQueue catches to remove the id from in-flight tracking so the periodic sweep can retry it (a discarding policy would leave ids stuck in-flight forever).",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/ScoringQueue.java",
          "version": "repo-file-v1:sha256:4b9183c5c46b67f409ce2f7c1233d4b82ac25e8b0bcb777e3dac9e6c05a83393"
        }
      ]
    },
    {
      "id": "claim_10eb02203ec247908f255ebf25042657",
      "statement": "No @Async annotation is used for interest scoring; InterestScoringListener (a @TransactionalEventListener on ArticlesIngestedEvent, AFTER_COMMIT) and the periodic sweep hand article ids to ScoringQueue explicitly, which executes scoring work on the dedicated interestScoringExecutor rather than the polling thread.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/InterestScoringListener.java",
