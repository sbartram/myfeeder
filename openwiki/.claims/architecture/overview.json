    {
      "id": "claim_5181345dd27f4248aef12f6a0945b0c3",
      "statement": "FeedFetcher is the single fetch path for all caller-influenced outbound HTTP: it is used by feed subscribe/poll (FeedService, FeedPollingService) and by ArticleExtractionService's reader-view page fetch, so any new feature needing to dereference a remote URL should route through it rather than issuing a raw RestClient call.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/ArticleExtractionService.java#L16-L48",
          "version": "repo-lines-v1:sha256:6fc6bef65a5be06ee3424d7b11eb5d8f4f19131f81a86aade38724b5d44b7d87:"
