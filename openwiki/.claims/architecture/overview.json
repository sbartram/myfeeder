    {
      "id": "claim_747dbf1fafaa4aa9bd8a07f3660d8303",
      "statement": "Every FeedFetcher.fetch call first invokes FeedUrlValidator.validate as an SSRF guard: it requires an http/https scheme and rejects URLs whose resolved host is loopback, link-local, RFC1918 site-local, any-local, multicast, carrier-grade NAT (100.64.0.0/10), the IPv4 limited-broadcast address, or an IPv6 unique-local (fc00::/7) address, throwing IllegalArgumentException (mapped to HTTP 400).",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/FeedFetcher.java#L46-L48",
          "version": "repo-lines-v1:sha256:f128f99e72198dfdd457a1cb5c1f2f8d66f40e7242685baa77346658bc05af7e:"
        },
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/FeedUrlValidator.java#L1-L135",
          "version": "repo-lines-v1:sha256:cae5d5e123c9cb00c88271d42fbc1952e5671975ccc7b154eed9fd004495dadf:"
        }
      ]
    },
    {
      "id": "claim_fd822928bb874c7f9c5bd32bde627358",
      "statement": "FeedUrlValidator's SSRF protection has two accepted limitations for the current single-user LAN deployment: it does not defend against DNS-rebinding/TOCTOU (the host is re-resolved when RestClient actually connects), and it does not re-validate the target URL on each HTTP redirect hop.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/FeedUrlValidator.java#L11-L26",
          "version": "repo-lines-v1:sha256:34adb679a280ba0f429db718aaa8a3c186b4ae09b221cb69b751d57177989b43:"
        }
      ]
    },
    {
      "id": "claim_b9567bfda62b4b4bb83d567e7bdf6c95",
      "statement": "ArticleExtractionService implements reader-view content extraction: given an article ID it fetches the article's original URL through FeedFetcher (inheriting the SSRF guard and size cap), decodes the bytes using the declared charset or jsoup's detection, extracts readable content with Readability4J, and caches the result in article.extracted_content on first request so later requests serve the cached copy.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/ArticleExtractionService.java#L16-L84",
          "version": "repo-lines-v1:sha256:3c075b3a3b248f3ce1cb57fdfa7f4fb354c679b56aa055830ee75d618797d3d1:"
        }
      ]
    },
    {
      "id": "claim_c6eb27f49fd1443eac6011f31554d7ab",
      "statement": "ArticleExtractionService.extract throws NotFoundException (404) if the article does not exist, IllegalArgumentException (400) if the article has no URL, FeedFetchException (422) if the page fetch fails, and FeedParseException (422) if Readability4J extracts no usable content.",
      "evidence": [
        {
          "resource": "repo://src/main/java/org/bartram/myfeeder/service/ArticleExtractionService.java#L28-L65",
