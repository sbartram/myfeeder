          "version": "repo-lines-v1:sha256:51c6e994e5b18d39220410fd1a45fcaca1c67a0a2bcebe4d2672bda5f851bc25:"
        }
      ]
    },
    {
      "id": "claim_db2b1ea5e1684122ad7db6671b6983d3",
      "statement": "Outbound RestClient timeouts/redirects are configured via the plural spring.http.clients.connect-timeout/read-timeout/redirects keys in Spring Boot 4.0.8; the singular spring.http.client.* keys were deprecated in Boot 4.0.0 and are silently not bound, so configuration using the old singular keys has no effect.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L252-L252",
          "version": "repo-lines-v1:sha256:4b7dc6b6e68b57aa4b2c96ac3ec6c874b85789a2e22b0a087624c68b350c0ea7:"
        }
      ]
    }
