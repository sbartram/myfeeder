    {
      "id": "claim_56ef7f9cbf5b4b2299cac10bbccc0a70",
      "statement": "The Helm chart optionally supports GCP Vertex AI credential plumbing: if secrets.googleApplicationCredentials (base64-encoded service-account JSON) is set, app-secret.yaml renders a gcp-credentials.json secret key and app-deployment.yaml mounts it read-only and sets GOOGLE_APPLICATION_CREDENTIALS=/var/secrets/gcp/gcp-credentials.json; this is unused by application code (no embeddings/Vertex usage in src/) and deploy.sh does not read or forward any corresponding env var, so it must be set manually via `helm upgrade --set`.",
      "evidence": [
        {
          "resource": "repo://deploy.sh",
          "version": "repo-file-v1:sha256:17de04c3fcc740d7d4b19cb28fa0918f08a0290262ddddc39b918270866e4573"
