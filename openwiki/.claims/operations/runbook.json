    {
      "id": "claim_6f3bb1ccfea64cb18e22a4daf91c9ee2",
      "statement": "helm/myfeeder/values.yaml defines app.image.pullPolicy: Always by default; using IfNotPresent is only safe with immutable release tags because SNAPSHOT/reused tags would otherwise not be re-pulled.",
