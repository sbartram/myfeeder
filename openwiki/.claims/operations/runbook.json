    {
      "id": "claim_d3b2aba437ca4caca99db7acd783ff83",
      "statement": "The interest-scoring sweep batch size and delay can be throttled either durably via myfeeder.interest.sweep-batch-size and myfeeder.interest.sweep-delay in application.yaml (requiring a release) or immediately without a release via `kubectl -n myfeeder set env deploy/myfeeder MYFEEDER_INTEREST_SWEEPBATCHSIZE=20`, relying on Spring Boot relaxed env-var binding and restarting the pod.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L242-L242",
          "version": "repo-lines-v1:sha256:2792cc3857e708588bbbe94a695c3f120984037c59b9c4b418be1c7966aa998a:"
