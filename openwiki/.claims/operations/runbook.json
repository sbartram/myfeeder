          "version": "repo-lines-v1:sha256:8465135d799683f416cfd387d16ed2fc3b0a8138d8f9c8ef1b029861daf77870:"
        }
      ]
    },
    {
      "id": "claim_25716e6fcd2a47d7b1d3e83bdca8e175",
      "statement": "The pg.bartram.org Postgres host used by the Helm chart's externalPostgres config is split-horizon DNS: only the LAN resolver has the real record, so k3s nodes must be configured (via k3s-ansible's lan_dns_servers and a CoreDNS forward block) to use the LAN resolver for bartram.org, while cert-manager bypasses cluster DNS via --dns01-recursive-nameservers-only for ACME.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L170-L170",
          "version": "repo-lines-v1:sha256:513b26a9c724bbfc64680215b7ed5dd36d64e126942aa7d3c6667bbc10ffd371:"
        },
