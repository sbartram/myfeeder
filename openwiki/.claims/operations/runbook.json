        }
      ]
    },
    {
      "id": "claim_88eb5fed93aa45dd99ec1af2ee160604",
      "statement": "helm/myfeeder/templates/app-deployment.yaml hardcodes JDK_JAVA_OPTIONS=-XX:MaxDirectMemorySize=64M on the app container (not exposed as a values.yaml field); this exists because the old Paketo buildpack image hardcoded a 10M direct-memory cap that starved Netty/Lettuce, though the current JRE-based Dockerfile image no longer strictly requires the override.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L159-L159",
