    {
      "id": "claim_d483cede4862487bac6318847b4bfe9b",
      "statement": "RestClientConfig registers a RestClientCustomizer bean that sets a `myfeeder/<version> (+https://github.com/bartram/myfeeder)` User-Agent header on every outbound RestClient call, working around CDNs (e.g. Vercel) that rate-limit the default JDK HttpClient User-Agent by returning HTTP 200 with a bogus body instead of an error; bypassing the auto-configured RestClient.Builder loses this protection.",
      "evidence": [
