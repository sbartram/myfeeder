        }
      ]
    },
    {
      "id": "claim_5afe0b14b4b84593a43d8887d3644e3f",
      "statement": "pg.bartram.org resolves only via the LAN DNS resolver (192.168.44.6); k3s nodes are configured (via k3s-ansible's lan_dns_servers) to use that resolver with a CoreDNS forward block routing bartram.org there, while cert-manager bypasses cluster DNS via --dns01-recursive-nameservers-only so ACME challenges still resolve public records.",
      "evidence": [
