    {
      "id": "claim_dc7ef8b24c1f42169d96fdede5343e77",
      "statement": "values.yaml defaults app.image.pullPolicy to Always rather than IfNotPresent, because reused SNAPSHOT/mutable tags would otherwise be cached stale by kubelet; IfNotPresent is only safe once tags are immutable release versions.",
