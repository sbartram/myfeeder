    {
      "id": "claim_e9084f38b1cc4a849966a84cf29ec90c",
      "statement": "An out-of-band `kubectl set env deploy/myfeeder MYFEEDER_INTEREST_SWEEPBATCHSIZE=...` override restarts the pod immediately but is not reliably cleared by a later `helm upgrade`'s three-way merge, so once the value is committed to application.yaml and deployed normally, the override must be explicitly removed with `kubectl set env ... MYFEEDER_INTEREST_SWEEPBATCHSIZE-`.",
      "evidence": [
