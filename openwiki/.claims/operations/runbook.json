    {
      "id": "claim_566e0f3225f64df681493fec6814c149",
      "statement": "The runtime image is built from a hand-written Dockerfile (eclipse-temurin:25-jre base) that only copies build/libs/*.jar; the jar must be produced on the host beforehand via `./gradlew clean bootJar`, which chains npmBuild -> processResources to embed the frontend and stamps the axion-release version into build-info.",
      "evidence": [
