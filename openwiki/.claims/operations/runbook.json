    {
      "id": "claim_05ed27e8ddb04328aed4db512a855d89",
      "statement": "config/RestClientConfig.java registers a RestClientCustomizer that sets a myfeeder/<version> User-Agent on every outbound RestClient call; bypassing the auto-configured RestClient.Builder bean (e.g. constructing a raw RestClient.builder()) loses this header and risks silent CDN rate-limiting (observed with Vercel returning HTTP 200 with a bogus body for the default JDK HttpClient user agent).",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L168-L168",
          "version": "repo-lines-v1:sha256:5064688e7bbfc34c37668fa4149c4edf5aba1a5d0d4fdaa2c3386804326f586f:"
        }
      ]
    },
    {
      "id": "claim_9322b24772dc4796ac2c71d8aca57e33",
      "statement": "`./gradlew release` and `pushRelease` clear axion-release's default jgit-based push action (which cannot read OpenSSH-format keys) and finalize via a custom gitPushRelease Exec task running `git push --follow-tags origin HEAD`; a stray global git-lfs pre-push hook can still intermittently block this push even though the repo has no LFS content, fixed via `git config lfs.<remote-url>.locksverify false`.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L164-L164",
          "version": "repo-lines-v1:sha256:21a7fe34f94f0f80f9cc5c346c8be2bd2fd46e40797cb3353843857bbce343e1:"
