        }
      ]
    },
    {
      "id": "claim_a0171912e32543b2a437c647d331a446",
      "statement": "deploy.sh requires MYFEEDER_PG_PASSWORD and MYFEEDER_ANTHROPIC_API_KEY to be set (used unguarded under `set -euo pipefail`), while MYFEEDER_RAINDROP_API_TOKEN is optional and defaults to empty, printing a warning and leaving Raindrop disabled when unset.",
      "evidence": [
        {
          "resource": "repo://deploy.sh#L1-L25",
          "version": "repo-lines-v1:sha256:17de04c3fcc740d7d4b19cb28fa0918f08a0290262ddddc39b918270866e4573:"
        }
      ]
    },
    {
      "id": "claim_74bf815fa7b545089af2bc10958338f4",
      "statement": "deploy.sh always passes an explicit image tag to `helm upgrade --install`; if no version argument is given it falls back to `./gradlew currentVersion -q`, which computes the next snapshot version and will not match a previously pushed release image.",
      "evidence": [
