    {
      "id": "claim_af9ed3cad9c14a04a2022ce27e7f7721",
      "statement": "Cutting a myfeeder release requires running `./gradlew release` (axion-release cut+push tag) strictly before `./gradlew clean bootJar`; building the jar first stamps it `-SNAPSHOT` instead of the release version.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L103-L118",
          "version": "repo-lines-v1:sha256:c8eac42e700cfab3a3009ee5c733b9dfc090947e4e42912777a31a9ff0dd2c79:"
