          "version": "repo-lines-v1:sha256:9d932bb94b396e87a190ebae74d1fa61816941057be3fee87a129833b5f8df4b:"
        }
      ]
    },
    {
      "id": "claim_3132f2c6e0de4768b9fe4060220b8684",
      "statement": "The Helm app Deployment gates liveness/readiness behind a startupProbe (periodSeconds/failureThreshold configurable under values.yaml app.probes.*, default 5s x 60 = up to 5 minutes) hitting /actuator/health, and does not set initialDelaySeconds on the liveness probe because the startup probe is the intended gate.",
      "evidence": [
        {
          "resource": "repo://helm/myfeeder/templates/app-deployment.yaml#L59-L76",
          "version": "repo-lines-v1:sha256:709a91feeb695aa47a0a67312da7e03454594aa287ba32ae776cf6cec498e402:"
        },
        {
